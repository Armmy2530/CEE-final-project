# Copy to .env and fill in. NEVER commit .env
PORT=3000
TZ_NAME=Asia/Bangkok
PUBLIC_APP_URL=http://localhost:3000

# --- Google Sheets (leave empty to use built-in mock data) ---
# Sheet must be shared as "Anyone with the link can view".
# Tabs required: Members, Events, Attendance, Budget
GOOGLE_API_KEY=
GOOGLE_SHEET_ID=
SHEET_CACHE_SECONDS=30

# --- AI chatbox via OpenRouter (leave empty to use the built-in offline answerer) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# --- Database file for accounts/sessions ---
DB_PATH=./data/app.db
