# Copy to .env and fill in. NEVER commit .env
PORT=3000
TZ_NAME=Asia/Bangkok

# --- Google Sheets (leave empty to use built-in mock data) ---
# Sheet must be shared as "Anyone with the link can view".
# Tabs required: Members, Events, Attendance, Budget, Project
GOOGLE_API_KEY=
GOOGLE_SHEET_ID=
SHEET_CACHE_SECONDS=30

# --- AI chatbox (leave empty to use the built-in offline answerer) ---
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-5-5

# --- Database file for accounts/sessions ---
DB_PATH=./data/app.db
