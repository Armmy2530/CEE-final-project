{
  "name": "club-activity-dashboard",
  "version": "2.0.0",
  "description": "Club Dashboard - Bun + SvelteKit (Svelte 5) + Google Sheets + bun:sqlite + OpenRouter AI",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun ./node_modules/vite/bin/vite.js dev",
    "build": "bun --bun ./node_modules/vite/bin/vite.js build",
    "preview": "bun --bun ./node_modules/vite/bin/vite.js preview",
    "start": "bun ./build/index.js",
    "test": "bun test",
    "check": "svelte-kit sync && tsc --noEmit"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/bun": "^1.4.4",
    "svelte": "^5.57.3",
    "svelte-adapter-bun": "^1.0.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.8"
  },
  "dependencies": {
    "@humanspeak/svelte-markdown": "^2.3.0",
    "@svar-ui/svelte-calendar": "^2.7.1"
  }
}
